    "\"\"\"\n",
    "Customer Churn Prediction with KNN\n",
    "Author: Francesco\n",
    "Description: Predict whether a customer will churn or stay using KNN\n",
    "\"\"\"\n",
    "\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    confusion_matrix,\n",
    "    classification_report\n",
    ")\n",
    "\n",
    "# Load the Telco customer churn dataset\n",
    "print(\"Loading Telco customer churn dataset...\")\n",
    "df = pd.read_csv(\"WA_Fn-UseC_-Telco-Customer-Churn.csv\")\n",
    "\n",
    "# Inspect the loaded data\n",
    "print(f\"\\nDataset type: {type(df)}\")\n",
    "print(f\"Number of customers: {len(df)}\")\n",
    "print(f\"Rows and columns: {df.shape}\")\n",
    "print(f\"Target values before encoding: {df['Churn'].unique()}\")\n",
    "\n",
    "print(\"\\nFirst few rows:\")\n",
    "print(df.head())\n",
    "\n",
    "print(\"\\nDataset info:\")\n",
    "df.info()\n",
    "\n",
    "# Count the original text labels\n",
    "print(\"\\nChurn distribution before encoding:\")\n",
    "print(df[\"Churn\"].value_counts())\n",
    "\n",
    "# Convert the target labels to numbers:\n",
    "# No = 0 (customer stayed), Yes = 1 (customer churned)\n",
    "df[\"Churn\"] = df[\"Churn\"].map({\"No\": 0, \"Yes\": 1})\n",
    "\n",
    "# Check the numeric labels\n",
    "print(\"\\nChurn distribution after encoding:\")\n",
    "print(df[\"Churn\"].value_counts().sort_index())\n",
    "print(f\"No churn (0): {(df['Churn'] == 0).sum()}\")\n",
    "print(f\"Churn (1): {(df['Churn'] == 1).sum()}\")"
   ]
